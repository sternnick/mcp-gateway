# MCP gateway: environment template (keep private, chmod 600)
# Copy to .env and fill in real values.

# LLM inference server: use the address of YOUR server, e.g. gpu-host.example:<port>
LITELLM_BASE_URL=http://<host>:<port>
LITELLM_API_KEY=

# Internal services (host loopback: internal only)
LANGGRAPH_URL=http://<host>:<port>
RAG_URL=http://<host>:<port>
RAG_AGENT_ID=<principal-id>
RAG_HMAC_SECRET=
RAG_BEARER_TOKEN=

# SearXNG metasearch (internal only)
SEARXNG_URL=http://<host>:<port>

# Server binding
MCP_HOST=<bind-address>   # in a container, bind all interfaces; in a test, localhost
MCP_PORT=<integer>

# Bearer auth: REQUIRED. Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
# Must match the Authorization header in ~/.config/mcp/mcp.json on the Pi host.
# This stays the OPERATOR token. It means RAG_AGENT_ID and sees every tool.
MCP_AUTH_TOKEN=

# --- MULTI-USER ACCESS (optional; leave unset for single-identity mode) -------
# One gateway, many agents: each bearer token names a principal, each principal
# gets its OWN memory tenant and its OWN tool list. All three values are JSON
# objects. Set NONE of them and the gateway behaves exactly as it did before
# this feature: that is the rollback path, no rebuild required.
#
# bearer token -> principal. Generate a token per agent with the one-liner
# above. Anyone whose token is absent here cannot get past the bearer gate.
#MCP_PRINCIPALS={"<token-a>":"<principal-a>","<token-b>":"<principal-b>"}
#
# principal -> its RAG HMAC secret. These are the SAME secrets already listed in
# the rag_memory stack's AGENT_SECRETS: reuse them, do not invent new ones, or
# an existing tenant's memories become unreadable. A principal missing here
# falls back to RAG_HMAC_SECRET; if that is empty its memory calls fail closed.
#RAG_AGENT_SECRETS={"<principal-a>":"<secret-a>","<principal-b>":"<secret-b>"}
#
# principal -> ["*"] or a list of groups. Groups are defined in server.py
# TOOL_GROUPS and cover all 53 tools: memory(7) memory_admin(1) search(6)
# browser(15) llm(8) external(2) yt(4) email(4) host(4) meta(2).
# A known principal with NO entry here gets NOTHING: a missing line is never a
# grant. host (docker_*, system_status, retention_status) and email are kept
# off ordinary agents on purpose: an agent should not profile or act on the
# machine it runs on, and memory_purge_trash is irreversible. external is its
# own group: it spends a third-party quota off-host: so it is granted per
# principal, never inherited with llm.
# Each principal is scoped deliberately: a wildcard would grant host, email,
# memory_admin and external as well, so the only thing keeping an automated run out of
# `email_approve` and `memory_purge_trash` was a sentence in a markdown file the gateway
# never reads. An agent's own profile is "look things up, read the web, ask a model,
# remember something"; it does not need to profile the host it runs on, send mail, purge a
# tenant's trash, or spend an external quota. Grant those to a HUMAN-driven principal by
# naming the group deliberately, and never as an inherited default.
#MCP_ACL={"<principal-a>":["<surface-a>","<surface-b>"],"<principal-b>":["memory","search","browser","llm","yt","meta"]}

# --- Browser memory budget (#332) --------------------------------------------
# The page cap is derived from MemAvailable at the moment a page is created, not from a
# constant: 32 pages on a 5.7 GiB box was measured at 15 live pages, 2.1 GiB available and
# 228 KB of swap. An explicit CAMO_MAX_PAGES still wins if an operator pins one.
#CAMO_PAGE_RAM_MIB=350
#CAMO_RAM_RESERVE_MIB=1024
#CAMO_MIN_PAGES=2

# --- camo_search queue (#331) -------------------------------------------------
# camo_search is the slowest tool (measured p95 67 s), so a 20 s queue could never hold a
# caller behind it: two browser operations run at a time and a queued call waits up to this
# long before an admission error that carries queue_waited_s / queue_budget_s.
#MCP_ADM_SCOPE_CAMO=2
#MCP_ADM_QUEUE_CAMO_SEARCH_SECONDS=120

# --- YouTube call budget (#330) ----------------------------------------------
# Policy, not pacing: how many YouTube asks this process allows per client session and in a
# rolling 24 h window. Refusal is reason=yt_budget_exhausted with the reset window.
#YT_BUDGET_PER_SESSION=12
#YT_BUDGET_PER_24H=40

# --- Build identity (#373) ---------------------------------------------------
# Baked into the image at build time by the Dockerfile (ARG GIT_COMMIT -> ENV), so
# `gateway_info()` and the /metrics gateway_build_info gauge can say which commit is
# running without host access. Do NOT set these in a runtime .env: a value that survives a
# rebuild unchanged is worse than none, because it launders a failed deploy into a green
# check.
# Three build-time keys carry the commit, the dirty flag and the build time. They are named
# in the private deployment template, not here: they belong to the image, and a reader of
# this file does not need their internal names to know to leave them alone. The
# authoritative value at runtime is the OCI label on the running image.
# The third build-time key (the build stamp the image writes into its own metadata) is
# likewise build-time only. Nothing here needs to be set for it.

# --- Long-audio ASR (#350) ---------------------------------------------------
# The ASR backend truncates input past ~16 s and still answers 200, so gpu_stt splits long
# recordings into windows, stitches them with absolute timestamps, and REFUSES a transcript
# whose coverage falls short. 14 s windows with 2 s overlap were the first size measured to
# come back complete every time; the split needs an ffmpeg binary (the image ships
# Playwright's, and GPU_STT_FFMPEG overrides the lookup).
#GPU_STT_SEGMENT_SECONDS=14
#GPU_STT_OVERLAP_SECONDS=2
#GPU_STT_MIN_COVERAGE=0.98
#GPU_STT_WINDOW_MIN_COVERAGE=0.90
# #208. A window that answers thin is asked AGAIN; if it stays thin the region has no words in it
# (music, ambience, a long pause) and is tolerated up to max(FLOOR, FRACTION x file) before the
# call is refused as incomplete. 30 s / 10 %: measured on the file that motivated this, one 8.7 s
# outro window out of 752.72 s was failing an otherwise complete transcript.
#GPU_STT_UNRECOGNIZED_FLOOR_SECONDS=30
#GPU_STT_UNRECOGNIZED_FRACTION=0.10
# #208: wall-clock the tool gives itself before it stops and returns what it proved (partial:true,
# resume_from_seconds). Cost measured at 0.135 s per second of audio, so 240 s covers roughly a
# 30-minute recording; keep it BELOW whatever timeout your client uses, or the client times out
# first and gets nothing.
#GPU_STT_BUDGET_SECONDS=240
#GPU_STT_FFMPEG=

# --- YouTube egress breaker (#386) -------------------------------------------
# The cooldown doubles per CONSECUTIVE rate-limit/bot-check arm with no success in between,
# capped here. After YT_COOLDOWN_ARMS_HARD_LIMIT consecutive arms the refusal stops
# advertising itself as retryable and names the human action: a fixed window is what
# livelocked the address for 40+ minutes on 2026-10-23.
#YT_COOLDOWN_MAX_SECONDS=21600
#YT_COOLDOWN_ARMS_HARD_LIMIT=6

# Retention: auto-delete generated files (transcripts etc.) older than N days.
# Memories are NEVER auto-deleted.
RETENTION_DAYS=<integer>

# Send-only email (SMTP): HUMAN-APPROVAL GATED.
# Agents can DRAFT emails but can NEVER send: email_approve() requires
# EMAIL_APPROVE_TOKEN, which only the human holds. No IMAP (send-only).
SMTP_HOST=<smtp-host>
SMTP_PORT=<port>
SMTP_USER=<mailbox>@<domain>
SMTP_PASS=
EMAIL_FROM=<mailbox>@<domain>
# comma-separated recipient allowlist (lowercase). Agents cannot even draft to others.
# EMAIL_ALLOWLIST removed: any recipient allowed (human token is the only gate)
# human-only token for email_approve: generate with:
# python3 -c "import secrets; print(secrets.token_urlsafe(24))"
EMAIL_APPROVE_TOKEN=
EMAIL_DAILY_LIMIT=<integer>
# SMTP transient-failure retries (1st attempt + 1 retry). If both fail, the
# draft STAYS in the queue, the caller gets status "retry_needed", and a
# new human approval can pick it up again.
EMAIL_SMTP_RETRIES=<integer>
EMAIL_SMTP_RETRY_DELAY=<integer>

# =============================================================================
# Everything from here down is OPTIONAL: server.py has a working default for
# each key, and these lines mirror those defaults so the surface is
# discoverable and reviewable.
#
# tests/mcp-server/check_env_example_sync.py runs in CI and fails if server.py
# reads a key that is not documented in this file. Add the key here (with its
# default) in the same change that adds the os.getenv() call.
# =============================================================================

# --- External reviewer (external_review / external_status) -------------------
# Sends the question OFF-HOST to a third-party model and spends an
# account-level quota. Free-tier ids only; a paid fallback is forbidden.
# OPENROUTER_API_KEY is a secret: set it in .env on the host, never in git.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=http://<host>:<port>
EXTERNAL_MODEL=<provider/model-id>
EXTERNAL_FALLBACK=<true|false>
EXTERNAL_FALLBACK_MODEL=<provider/model-id>
EXTERNAL_ATTEMPTS=<integer>
EXTERNAL_ATTEMPT_TIMEOUT=<integer>
EXTERNAL_DEADLINE=<integer>
EXTERNAL_QUEUE_WAIT=<integer>
EXTERNAL_RETRY_BASE=<integer>
EXTERNAL_RETRY_MAX=<integer>

# --- MCP admission control --------------------------------------------------
# Bounds concurrent tool calls globally and per principal; a request over the
# limit waits up to MCP_ADM_QUEUE_TIMEOUT_SECONDS before it is told to retry.
MCP_ADM_GLOBAL_MAX_ACTIVE=<integer>
MCP_ADM_PRINCIPAL_MAX_ACTIVE=<integer>
MCP_ADM_QUEUE_TIMEOUT_SECONDS=<integer>
MCP_ADM_RETRY_AFTER_SECONDS=<integer>
MCP_ADM_SCOPE_GPU_CHAT=<integer>
MCP_ADM_SCOPE_GPU_EMBED=<integer>
MCP_ADM_SCOPE_MEMORY_RAG=<integer>
MCP_ADM_SCOPE_RESEARCH=<integer>
MCP_ADM_SCOPE_SEARXNG_SEARCH=<integer>

# --- Search cache -----------------------------------------------------------
# Identical (query, engines, time_range, max_results) requests share this cache.
# 0 disables the cache cleanly; request single-flight stays on.
MCP_SEARCH_CACHE_TTL_S=<integer>
MCP_SEARCH_CACHE_MAX_ENTRIES=<integer>

# --- Camo (anti-detect Firefox) -------------------------------------------
# The persistent fingerprint IS the point: these values define it, so they must
# stay stable across restarts or the profile stops looking like one browser.
CAMO_PROFILE=<path-to-profile.json>
# EMPTY = derive from available memory. A number pins the cap,
# which is how a host ends up with more live pages than it can hold.
CAMO_MAX_PAGES=
CAMO_PAGE_IDLE_SECONDS=<integer>
CAMO_OS=<windows|macos|linux>
CAMO_LOCALE=<locale, e.g. en-US>
CAMO_LANGUAGES=<comma-separated language tags>
CAMO_TIMEZONE=UTC
CAMO_SCREEN=<width>,<height>
CAMO_CORES=<core count to report>
CAMO_MEMORY=<GB of memory to report>
CAMO_HUMANIZE=<true|false>

# --- Browser (headless Chromium) --------------------------------------------
BROWSER_MAX_PAGES=<integer>
BROWSER_PAGE_IDLE_SECONDS=<integer>
BROWSER_BACKPRESSURE_SECONDS=<integer>
BROWSER_CLEANUP_INTERVAL_SECONDS=<integer>
BROWSER_SHUTDOWN_WHEN_IDLE=<true|false>

# How long a host already judged PUBLIC stays trusted by the per-request SSRF
# guard (#194), in seconds. A route handler runs for every request a page makes
# -- dozens -- and each uncached verdict costs a getaddrinfo, so some caching is
# required; this is the knob that trades that cost against the DNS-rebinding
# window. It is deliberately NOT a knob to raise: hosts judged PRIVATE are never
# cached, so lowering this only narrows the rebinding window at some latency.
# Watch system_status.ssrf_guard.pages_unguarded (must stay 0) rather than this.
SSRF_DNS_TTL_SECONDS=<integer>
# How many redirect hops the guard will walk before it gives up on a chain. A
# normal page never approaches this; it exists so a redirect loop cannot spin the
# guard forever. Exceeding it is reported as a block, not as a timeout.
SSRF_MAX_REDIRECTS=<integer>

# --- Docker (docker_ps / docker_logs) --------------------------------------
# An empty DOCKER_API_URL means "talk to the socket at DOCKER_SOCKET_PATH".

# How long a page's text extraction may take before research_fetch/research call the
# fetch a failure (#273). Default 30s, unchanged from the previously hard-coded value;
# exposed so the timeout path is testable without waiting or mocking the module's own
# wait_for. A timed-out extraction now returns reason=fetch_timeout instead of text="".
FETCH_EXTRACT_TIMEOUT_SECONDS=<integer>
# Read-only Docker API proxy (issue #300, ADR-20260910 Decision 7). Leave this
# EMPTY to take the compose default, http://localhost:2375 -- the proxy stack in
# your docker-socket-proxy stack. Set it only if the proxy moves.
# DOCKER_SOCKET_PATH is now a fallback for a non-default socket path and is
# unused while DOCKER_API_URL is set; the socket is no longer mounted into this
# container at all, and deploy/tests/test_no_docker_socket_mount.sh enforces that.
DOCKER_API_URL=
DOCKER_SOCKET_PATH=<path>

# --- YouTube transcripts ---------------------------------------------------
YT_OUTPUT_DIR=<path>
YT_MAX_CONCURRENT=<integer>
# Hard wall-clock ceiling for ONE yt-dlp child process, in seconds (#147).
# A child hung by YouTube throttling or a bot-wall used to block the call until
# the client gave up while holding one of the YT_MAX_CONCURRENT slots. 45 is ~4x
# the worst measured successful yt_transcript call (11 s), so it bounds a hang
# without turning a slow-but-working download into a failure. Raise it only if a
# real transcript is killed by it -- and say so in the commit that raises it.
YT_SUBPROCESS_TIMEOUT_SECONDS=<integer>
# Minimum spacing between YouTube tool CALLS, seconds (#227). The semaphore above bounds MEMORY;
# this bounds RATE, and the quota that matters is YouTube's subtitle limit, which is counted per
# egress ADDRESS and shared with the browser on that address. 4 s is a chosen floor, not a measured
# one - it is the smallest value that keeps a 5-call session comfortably away from the wall we have
# been told about but never seen ourselves. Lower it only with a 429/bot-check log line to justify it.
YT_MIN_INTERVAL_SECONDS=<integer>
# How long the circuit stays open after ONE 429 / bot-check, seconds (#227). While open every
# YouTube tool is refused with retry_after, because the retry - not the first failure - is what
# turns a per-video limit into a per-address one (#226). 900 s is a guess at the recovery window of
# a shared address; it is deliberately generous, since refusing one caller is cheaper than burning
# the address for a day for all of them.
YT_COOLDOWN_SECONDS=<integer>

# --- Paths (container paths; DATA_DIR is the host bind-mount) ---------------
# The host bind-mount behind DATA_DIR is
# the gateway's data directory. retention_status reports against it.
DATA_DIR=<path>
MCP_ARTIFACTS_DIR=<path>
EMAIL_QUEUE_DIR=<path>
RETENTION_LOG=<path>
MCP_HEALTHZ_PATH=<path>
MCP_METRICS_PATH=<path>
MCP_DEBUG_PATH=<path>

# --- Deploy provenance (written by CI at deploy time; leave as-is) ----------
MCP_DEPLOY_COMMIT=<value>
MCP_DEPLOY_DIRTY=<value>

# --- Misc ------------------------------------------------------------------
DEFAULT_MODEL=<model-id>
MCP_INFLIGHT_MAX_AGE=<integer>

# --- Principal attribution strictness (#433) ------------------------------------
# true (default): on a MULTI-PRINCIPAL deployment (MCP_PRINCIPALS set), a call that
# resolves to no principal is refused instead of running as MCP_DEFAULT_PRINCIPAL :
# which is the default principal, i.e. its memory space and its tool set. Background
# work (retention loop, browser reaper, CLI import) and single-identity deployments are
# unaffected: see _current_principal() in server.py.
# false: the pre-#433 behaviour, unattributed calls fall back to the default principal.
# Running that way is not invisible: system_status.principal_attribution shows
# {unattributed_denied, unattributed_fallback, deny_unattributed, multi_principal}.
MCP_DENY_UNATTRIBUTED=<true|false>
